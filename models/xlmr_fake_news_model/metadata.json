{
  "model_name": "xlm-roberta-base",
  "task": "Arabic fake news detection",
  "task_type": "binary_text_classification",
  "framework": {
    "transformers": "Hugging Face Transformers",
    "deep_learning": "PyTorch",
    "evaluation": "scikit-learn"
  },
  "max_len": 256,
  "tokenization": {
    "padding": "max_length",
    "truncation": true,
    "text_column": "text",
    "tokenizer_source": "xlm-roberta-base"
  },
  "num_labels": 2,
  "label2id": {
    "real": 0,
    "fake": 1
  },
  "id2label": {
    "0": "real",
    "1": "fake"
  },
  "dataset": {
    "fake_dataset_file": "fake_news_dataset_10k.json",
    "real_dataset_file": "Real_news_dataset_10k.json",
    "fake_articles_loaded": 10000,
    "real_articles_loaded": 10000,
    "total_articles_after_cleaning": 20000,
    "empty_or_null_articles_dropped": 0,
    "class_distribution": {
      "real": 10000,
      "fake": 10000
    },
    "split": {
      "strategy": "stratified train/validation/test split",
      "train_ratio": 0.8,
      "validation_ratio": 0.1,
      "test_ratio": 0.1,
      "train_samples": 15999,
      "validation_samples": 2001,
      "test_samples": 2000
    }
  },
  "reproducibility": {
    "seed": 42
  },
  "training": {
    "num_train_epochs": 4,
    "learning_rate": 2e-05,
    "weight_decay": 0.01,
    "per_device_train_batch_size": 16,
    "per_device_eval_batch_size": 32,
    "gradient_accumulation_steps": 2,
    "effective_train_batch_size": 32,
    "warmup_ratio": 0.06,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "load_best_model_at_end": true,
    "metric_for_best_model": "f1",
    "greater_is_better": true,
    "logging_strategy": "steps",
    "logging_steps": 50,
    "fp16": true,
    "report_to": "none",
    "early_stopping": {
      "callback": "EarlyStoppingCallback",
      "early_stopping_patience": 2
    },
    "output_dir": "./xlmr-fake-news-checkpoints"
  },
  "decision": {
